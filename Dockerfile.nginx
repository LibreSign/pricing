FROM nginx:1.31.8-alpine3.24@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606
# Keep the pinned base but apply the Alpine security fix also used by LibreCode's nginx image.
RUN apk upgrade --no-cache brotli-libs \
    && sed -i '/^user .*;/d;s/worker_processes auto;/worker_processes 2;/' /etc/nginx/nginx.conf
COPY docker/nginx/pricing.conf /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080

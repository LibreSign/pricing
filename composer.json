{
    "name": "libresign/pricing",
    "description": "Deterministic, auditable LibreSign pricing simulations",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "brick/math": "^1.0",
        "php": "^8.5",
        "symfony/framework-bundle": "^8.1",
        "symfony/string": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9.1",
        "nelmio/api-doc-bundle": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "LibreSign\\Pricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibreSign\\Pricing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "style": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "style:fix": "php-cs-fixer fix --using-cache=no",
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit --colors=never",
        "api:generate": "@php tools/generate-openapi.php",
        "api:check": "@php tools/generate-openapi.php --check",
        "check": [
            "@lint",
            "@style",
            "@analyse",
            "@test",
            "@api:check",
            "composer audit --locked"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
